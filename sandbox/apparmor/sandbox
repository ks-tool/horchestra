# AppArmor profiles for the sandbox binaries.
#
# Ubuntu 24.04 and later ship kernel.apparmor_restrict_unprivileged_userns=1, which stops an
# unconfined process from creating a user namespace. Stage one does exactly that, so without a
# profile granting `userns` the sandbox stops at:
#
#   fork/exec /proc/self/exe: operation not permitted
#
# Install and load:
#
#   sudo install -m 0644 apparmor/sandbox /etc/apparmor.d/sandbox
#   sudo systemctl reload apparmor        # or: sudo apparmor_parser -r /etc/apparmor.d/sandbox
#
# The attachment paths below must match where the binaries actually are — edit them if you
# install somewhere other than /usr/local/bin, or the profile simply never applies and the
# failure looks unchanged.
#
# flags=(unconfined) keeps the profile from confining anything else: the sandbox's own
# confinement is its namespaces, capability drop and seccomp filter, and an AppArmor policy
# written on top of those would have to be maintained against every image a workload runs.
# The blunt alternative to this file is kernel.apparmor_restrict_unprivileged_userns=0, which
# lifts the restriction for every program on the host rather than these two.

abi <abi/4.0>,

include <tunables/global>

profile sandbox /usr/local/bin/sandbox flags=(unconfined) {
  userns,

  include if exists <local/sandbox>
}

profile sandbox-strict /usr/local/bin/sandbox-strict flags=(unconfined) {
  userns,

  include if exists <local/sandbox-strict>
}
